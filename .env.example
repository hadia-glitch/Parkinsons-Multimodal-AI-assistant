# ---------------------------------------------------------------------------
# Server settings (required)
# ---------------------------------------------------------------------------
# The API server reads this file automatically at startup (via Node's
# --env-file-if-exists), so `cp .env.example .env` is all you need — no
# manually exporting variables in your shell each session.
PORT=5000
NODE_ENV=development

# Optional OpenAI-compatible provider
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# Optional local provider
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=

# Optional multimodal providers
VISION_MODEL=

# Python speech-screening microservice (ml-speech-service). Leave blank to
# keep audio uploads in the honest "unavailable" state. See
# ml-speech-service/DEPLOY.md for hosting instructions (this cannot run on
# Vercel serverless functions).
SPEECH_SERVICE_URL=
SPEECH_SERVICE_TIMEOUT_MS=20000

# Python gait-screening microservice (ml-gait-service). Leave blank to keep
# video uploads in the honest "unavailable" state. See
# ml-gait-service/README.md (getting CARE-PD data + training) and
# ml-gait-service/DEPLOY.md (hosting) — same "not Vercel serverless" caveat.
GAIT_SERVICE_URL=
GAIT_SERVICE_TIMEOUT_MS=30000

# Weights for /api/screen's combined speech+gait score when both modalities
# are supplied and succeed. Not claimed to be clinically optimal (plan.md §20).
SPEECH_WEIGHT=0.5
GAIT_WEIGHT=0.5

# Live retrieval — PubMed via NCBI E-utilities, works with no key at a
# lower rate limit (3 req/s). Add a free NCBI API key to raise it to
# 10 req/s: https://www.ncbi.nlm.nih.gov/books/NBK25497/#chapter2.Getting_Started
SEARCH_API_KEY=

# Server settings
MAX_UPLOAD_SIZE_MB=25
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Frontend deployments may use a remote API base URL.
VITE_API_URL=